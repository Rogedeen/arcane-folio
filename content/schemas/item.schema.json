{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Item",
  "type": "object",
  "required": [
    "slug",
    "name",
    "type",
    "cost",
    "weight",
    "description",
    "quantity",
    "source",
    "source_ref",
    "license"
  ],
  "properties": {
    "slug": { "type": "string" },
    "name": { "type": "string" },
    "type": {
      "type": "string",
      "enum": ["weapon", "armor", "shield", "gear", "potion", "scroll"]
    },
    "cost": { "type": "string" },
    "weight": { "type": "number", "minimum": 0 },
    "description": { "type": "string" },
    "properties": {
      "type": "array",
      "items": { "type": "string" }
    },
    "equipped": { "type": "boolean" },
    "quantity": { "type": "integer", "minimum": 1 },
    "source": { "type": "string" },
    "source_ref": { "type": "string" },
    "license": { "type": "string" }
  }
}
