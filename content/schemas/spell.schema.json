{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Spell",
  "type": "object",
  "required": [
    "slug",
    "name",
    "level",
    "school",
    "castingTime",
    "range",
    "components",
    "duration",
    "description",
    "classes",
    "source",
    "source_ref",
    "license"
  ],
  "properties": {
    "slug": { "type": "string" },
    "name": { "type": "string" },
    "level": { "type": "integer", "minimum": 0, "maximum": 9 },
    "school": { "type": "string" },
    "castingTime": { "type": "string" },
    "range": { "type": "string" },
    "components": { "type": "string" },
    "duration": { "type": "string" },
    "description": { "type": "string" },
    "classes": {
      "type": "array",
      "items": { "type": "string" }
    },
    "source": { "type": "string" },
    "source_ref": { "type": "string" },
    "license": { "type": "string" }
  }
}
